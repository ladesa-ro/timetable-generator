{
  "name": "Timetable Generator DevContainer",

  "service": "timetable-generator",
  "remoteUser": "dev",
  "workspaceFolder": "/app/",
  "dockerComposeFile": [
    "../docker-compose.devcontainer.yml"
  ],
  "postStartCommand": "clear; echo 'DevContainer pronto!'",
  "shutdownAction": "stopCompose",

  "remoteEnv": {
  },

  "forwardPorts": [
    8080,
    5672,
    15672
  ],

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/usr/bin/zsh",
        "dotnet.defaultSolution": "/app/Ladesa.TimetableGenerator/Ladesa.TimetableGenerator.slnx"
      },

      "extensions": [
        "ms-dotnettools.csharp",
      ]
    },
    "jetbrains": {
    }
  },
}
